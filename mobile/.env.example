# Mobile Environment Variables
# Copy this file to .env

# Backend API URL
# Local development: http://YOUR_LOCAL_IP:3000/api
# Production: https://your-backend.onrender.com/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Google OAuth — Web Client ID (same as GOOGLE_CLIENT_ID on backend)
# Get from Google Cloud Console > Credentials > OAuth 2.0 Client IDs (Web type)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here
