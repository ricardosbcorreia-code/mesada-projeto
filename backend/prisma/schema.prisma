generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Parent {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  password_hash        String?
  google_id            String?   @unique
  expo_push_token      String?
  reset_code           String?
  reset_code_expires   DateTime?
  created_at           DateTime  @default(now())
  children             Child[]
  rewards              Reward[]
  tasks                Task[]

  @@map("parents")
}

model Child {
  id               String             @id @default(uuid())
  parent_id        String
  name             String
  pin              String
  base_allowance   Decimal            @default(0.0) @db.Decimal(10, 2)
  expo_push_token  String?
  created_at       DateTime           @default(now())
  parent           Parent             @relation(fields: [parent_id], references: [id])
  redemptions      RewardRedemption[]
  task_assignments TaskAssignment[]

  @@map("children")
}

model Task {
  id                  String           @id @default(uuid())
  parent_id           String
  name                String
  description         String?
  type                TaskType
  value               Decimal          @db.Decimal(10, 2)
  recurrence_type     RecurrenceType
  recurrence_interval Int              @default(1)
  recurrence_days     Int[]            @default([])
  recurrence_month    Int?
  created_at          DateTime         @default(now())
  subtasks            SubTask[]
  assignments         TaskAssignment[]
  parent              Parent           @relation(fields: [parent_id], references: [id])

  @@map("tasks")
}

model TaskAssignment {
  id         String          @id @default(uuid())
  task_id    String
  child_id   String
  active     Boolean         @default(true)
  child      Child           @relation(fields: [child_id], references: [id])
  task       Task            @relation(fields: [task_id], references: [id])
  executions TaskExecution[]

  @@map("task_assignments")
}

model TaskExecution {
  id                  String              @id @default(uuid())
  assignment_id       String
  date                DateTime            @db.Date
  status              ExecutionStatus     @default(pending)
  subtask_completions SubTaskCompletion[]
  assignment          TaskAssignment      @relation(fields: [assignment_id], references: [id])

  @@map("task_executions")
}

model SubTask {
  id          String              @id @default(uuid())
  task_id     String
  label       String
  order       Int                 @default(0)
  completions SubTaskCompletion[]
  task        Task                @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@map("subtasks")
}

model SubTaskCompletion {
  id           String        @id @default(uuid())
  subtask_id   String
  execution_id String
  checked      Boolean       @default(false)
  checked_at   DateTime?
  execution    TaskExecution @relation(fields: [execution_id], references: [id], onDelete: Cascade)
  subtask      SubTask       @relation(fields: [subtask_id], references: [id], onDelete: Cascade)

  @@unique([subtask_id, execution_id])
  @@map("subtask_completions")
}

model Reward {
  id          String             @id @default(uuid())
  parent_id   String
  name        String
  description String?
  cost_in_xp  Int
  max_redeems Int?
  created_at  DateTime           @default(now())
  redemptions RewardRedemption[]
  parent      Parent             @relation(fields: [parent_id], references: [id])

  @@map("rewards")
}

model RewardRedemption {
  id         String           @id @default(uuid())
  reward_id  String
  child_id   String
  cost       Int
  status     RedemptionStatus @default(pending)
  created_at DateTime         @default(now())
  child      Child            @relation(fields: [child_id], references: [id])
  reward     Reward           @relation(fields: [reward_id], references: [id])

  @@map("reward_redemptions")
}

enum TaskType {
  mandatory
  bonus
  penalty
}

enum RecurrenceType {
  daily
  weekly
  monthly
  yearly
}

enum ExecutionStatus {
  pending
  completed
  approved
  rejected
}

enum RedemptionStatus {
  pending
  approved
  rejected
}
